    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@codemirror/lang-json": "^6.0.1",
    "angularx-qrcode": "^22.0.1",
    "bignumber.js": "^11.1.5",
    "buffer": "^6.0.3",
    "cbor-x": "^1.6.6",
    "codemirror": "^6.0.1",
    "crypto-js": "^4.2.0",
    "jsonpath-plus": "^10.3.0",
    "jwt-decode": "^4.0.0",
    "ngx-toastr": "20.0.5",
    "nofilter": "^6.4.1",
    "rxjs": "~7.8.0",
    "stream-browserify": "^3.0.0",
    "thememirror": "^2.0.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.6",
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.0.0",
