    "eslint": "^10.9.1",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "karma-sonarqube-reporter": "^1.4.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
