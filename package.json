{
  "name": "verifier-ui",
  "version": "0.12.1-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "npm run config && ng serve --proxy-config src/proxy.conf.json",
    "build": "npm run config && ng build --configuration=production",
    "watch": "npm run config && ng build --watch --configuration=development",
    "config": "node set-env.js",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage",
    "stylelint": "npx stylelint \"src/**/*.{css,scss}\" --fix",
    "lint": "ng lint --fix",
    "pre-build": "test && lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
